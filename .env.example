# Server Configuration
PORT=8000
NODE_ENV=development

# Security & Perimeter Controls
# Set HYPERFLOW_API_KEY to enforce Bearer / X-API-Key authentication on AI endpoints
HYPERFLOW_API_KEY=
# Comma-separated list of allowed origins (e.g. https://my-app.com,http://localhost:3000) or leave empty for *
ALLOWED_ORIGINS=
# Rate Limiting configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQ=60
RATE_LIMIT_WINDOW_SEC=60

# Privacy & Compliance
# Set to 'false' to redact prompt and response text before storing in database telemetry
STORE_PROMPTS_CONTENT=true

# Edge Database (Local SQLite file or remote Turso/libSQL connection string)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Real LLM Providers (Optional: falls back seamlessly to Edge Synthetic Simulator if unset)
# Option A: Groq (Ultra-low latency for Edge < 300ms)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option C: Custom OpenAI-compatible endpoint (Ollama, DeepSeek, LocalAI, etc.)
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# AI Execution Guardrails
AI_TIMEOUT_MS=8000
AI_MAX_TOKENS=512
